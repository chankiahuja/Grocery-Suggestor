{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "start": "pnpm build && node scripts/start-spring.mjs",
    "dev:mock": "pnpm --filter @workspace/grocery-app dev:mock",
    "preinstall": "node scripts/check-package-manager.mjs",
    "dev": "pnpm --filter @workspace/grocery-app dev",
    "build": "pnpm run typecheck && pnpm --filter @workspace/grocery-app build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter ./artifacts/** --filter ./scripts --if-present run typecheck"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
