# Docker Compose reads this file after copying it to .env.
# Root pnpm start loads this file. For direct native Java execution, set variables in your shell or IDE.
DB_URL=jdbc:postgresql://localhost:5432/pantrypal
DB_USER=pantrypal
DB_PASSWORD=pantrypal
API_PORT=8080
EXPIRY_CHECK_MS=60000
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=PantryPal <no-reply@pantrypal.test>
MAIL_USERNAME=
# For shared .env files, single-quote secrets that contain $ or # so Compose does not rewrite them.
# Example: MAIL_PASSWORD='pa$word'
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
# Compose-only SMTP overrides; defaults to its local Mailpit service.
PANTRYPAL_SMTP_HOST=
PANTRYPAL_SMTP_PORT=
# Set to a monitored support mailbox before enabling Contact & Feedback.
PANTRYPAL_SUPPORT_EMAIL=
# Optional, manually verified response expectation; shown only when set.
PANTRYPAL_SUPPORT_RESPONSE_TIME=
# Local HTTP only; use true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
# Optional 32+ byte value; unset uses a process-local secret and invalidates pending codes on restart.
AUTH_OTP_SECRET=
# Optional Vite overrides (defaults work without these).
PORT=5173
BASE_PATH=/
API_TARGET=http://localhost:8080
VITE_ENABLE_MOBILE_PREVIEW=false
