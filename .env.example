# Docker Compose reads this file after copying it to .env.
# For native Java execution set these variables in your shell or IDE too.
DB_URL=jdbc:postgresql://localhost:5432/pantrypal
DB_USER=pantrypal
DB_PASSWORD=pantrypal
API_PORT=8080
EXPIRY_CHECK_MS=60000
# Optional Vite overrides (defaults work without these).
PORT=5173
BASE_PATH=/
API_TARGET=http://localhost:8080
